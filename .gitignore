# Pyodide runtime, vendored out of node_modules by scripts/vendor-pyodide.mjs
# on every build. Generated, ~13 MB, and pinned by the pyodide version in
# package.json — there is nothing to gain from tracking it.
/public/pyodide
.env
./env
/.env.local
.env.local
.vercel

# config.json holds every API key the app has been given, in plaintext. The
# top-level one is covered by data/.gitignore, but a copy can end up nested
# under any build or scratch directory — this covers all of them, at any depth.
**/data/config.json
**/data/db.sqlite
