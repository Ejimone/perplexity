# NOTE: .vercelignore REPLACES .gitignore for upload filtering rather than
# adding to it. Everything sensitive has to be repeated here explicitly —
# omitting a line here does not fall back to .gitignore.

# Secrets. .env holds a real API key; data/config.json holds every key the
# desktop app has been given, in plaintext.
.env
.env.*
data

# Never useful in a deployment
node_modules
.next
release
coverage
*.log

# Desktop shell — the hosted build is the web app only
desktop
.assets
docs
searxng
certificates

# Regenerated during the build by the prebuild hook (scripts/vendor-pyodide.mjs)
public/pyodide

# ---------------------------------------------------------------------------
# Function budget.
#
# Vercel bills TWO serverless functions per route (the route plus its RSC
# payload) and the Hobby plan allows twelve — so the hosted build gets six
# routes in total, one of which Next spends on /_not-found automatically.
#
# Every API endpoint is therefore served by the single catch-all at
# src/app/api/[...path]/route.ts. The specific route files below are now thin
# re-exports of src/lib/api/*, so dropping them here costs no behaviour: the
# catch-all imports the same implementations. The desktop build keeps them and
# is unaffected.
# ---------------------------------------------------------------------------
src/app/api/canvas/assist
src/app/api/canvas/buffers
src/app/api/canvas/sandbox
src/app/api/canvas/surface
src/app/api/chat
src/app/api/chats
src/app/api/config
src/app/api/discover
src/app/api/images
src/app/api/local-runtime
src/app/api/providers
src/app/api/reconnect
src/app/api/search
src/app/api/suggestions
src/app/api/uploads
src/app/api/videos
src/app/api/weather

# Pages that need the local search engine, plus the two Next turns into an
# extra pair of functions each.
src/app/c
src/app/discover
src/app/library
src/app/manifest.ts
src/app/favicon.ico
